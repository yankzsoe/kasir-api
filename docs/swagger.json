        "/transactions/checkout": {
            "post": {
                "description": "Process a checkout transaction with items and calculate total amount",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Transactions"
                ],
                "summary": "Complete transaction checkout",
                "parameters": [
                    {
                        "description": "Items to checkout",
                        "name": "request",
                        "in": "body",
                        "required": true,
